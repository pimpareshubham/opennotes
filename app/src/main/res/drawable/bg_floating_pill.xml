<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer frosted acrylic body with light incidence gradient and specular rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#E625283A"
                android:endColor="#D4191B28"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#3DFFFFFF" />
        </shape>
    </item>
</layer-list>
