<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="?selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <ImageView
        android:id="@+id/imgFavStar"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_star_filled"
        app:tint="#F59E0B"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/textZoomPercent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:text="141%"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/badgeCurrentZoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_floating_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="Current"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Delete option with delete icon to remove from favorites -->
    <ImageButton
        android:id="@+id/btnDeleteFavoriteZoom"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="Remove from favorites"
        android:padding="8dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/text_secondary" />

</LinearLayout>
