<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notebookCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#801C1E2A"
    app:strokeWidth="1.2dp"
    app:strokeColor="#33FFFFFF"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Notebook Cover Aspect Box -->
        <FrameLayout
            android:id="@+id/coverContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_notebook_cover_height"
            android:background="@drawable/bg_notebook_cover">

            <ImageView
                android:id="@+id/coverImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Spine visual accent -->
            <View
                android:layout_width="16dp"
                android:layout_height="match_parent"
                android:background="#22000000" />

            <!-- Multi-select check indicator -->
            <ImageView
                android:id="@+id/checkSelect"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:padding="2dp"
                android:src="@drawable/ic_check_circle_outline"
                android:visibility="gone"
                android:contentDescription="Select notebook" />

            <ImageView
                android:id="@+id/iconPinned"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:padding="7dp"
                android:src="@drawable/ic_push_pin"
                android:contentDescription="Pinned notebook"
                app:tint="#38BDF8"
                android:visibility="gone" />

            <!-- Page count badge -->
            <TextView
                android:id="@+id/textPagesBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_search_bar"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="1 page"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Favorite star button -->
            <ImageView
                android:id="@+id/btnFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/text_secondary"
                android:background="?selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/textCoverCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="20dp"
                android:gravity="center"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Notebook Info Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_notebook_info_height"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical"
            android:background="#66141624">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textNotebookTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Untitled Notebook"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/home_notebook_title_text_size"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/textNotebookDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oct 15, 2026"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/home_notebook_date_text_size"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_secondary"
                android:background="?selectableItemBackgroundBorderless" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
