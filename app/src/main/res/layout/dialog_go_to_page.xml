<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_bg"
    android:padding="22dp">

    <!-- Header with Icon and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🎯"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_search_bar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Go to Page"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textGoToSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter page number or scrub slider"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnGoToClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_clear"
            app:tint="@color/text_secondary"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Center Card: Large Page Number Input and Total Count -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="@color/surface_card"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Page"
                    android:textColor="@color/text_hint"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginEnd="12dp" />

                <EditText
                    android:id="@+id/editPageNumber"
                    android:layout_width="96dp"
                    android:layout_height="54dp"
                    android:inputType="number"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/accent"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_page_number_input"
                    android:selectAllOnFocus="true"
                    android:maxLength="5" />

                <TextView
                    android:id="@+id/textTotalPagesBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="of 50"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Interactive Seek Bar for instant scrubbing -->
            <SeekBar
                android:id="@+id/seekPageScrubber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent"
                android:splitTrack="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Min/Max labels -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Page 1"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textMaxPageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Page 50"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </RelativeLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Jump Chips: First Page, Last Page, Grid Overview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/chipFirstPage"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="⏮ First Page"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_quick_chip"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/chipLastPage"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="⏭ Last Page"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_quick_chip"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/chipGridOverview"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.1"
            android:text="🗂 Grid View"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_quick_chip"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelGoTo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:cornerRadius="14dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmGoTo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.6"
            android:text="Jump to Page 🚀"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_blue"
            app:cornerRadius="14dp"
            app:elevation="4dp" />
    </LinearLayout>
</LinearLayout>
