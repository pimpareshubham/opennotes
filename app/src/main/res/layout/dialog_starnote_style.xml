<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_bg"
    android:padding="20dp"
    android:minWidth="320dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/textStyleDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Style"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseStyleDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_secondary" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Line Style Group (Solid, Dashed, Dotted) -->
            <LinearLayout
                android:id="@+id/groupLineStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stroke Style"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <FrameLayout
                        android:id="@+id/btnStyleSolid"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/graph_line_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Solid line">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:paddingHorizontal="16dp"
                            android:src="@drawable/graph_line_solid"
                            app:tint="@color/text_primary" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnStyleDash"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/graph_line_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Dashed line">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:paddingHorizontal="16dp"
                            android:src="@drawable/graph_line_dash"
                            app:tint="@color/text_primary" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnStyleDot"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/graph_line_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Dotted line">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:paddingHorizontal="16dp"
                            android:src="@drawable/graph_line_dot"
                            app:tint="@color/text_primary" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Thickness / Size Group -->
            <LinearLayout
                android:id="@+id/groupThickness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/textThicknessTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Thickness"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textThicknessValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="2.0 mm"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <SeekBar
                    android:id="@+id/seekThickness"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:max="100"
                    android:progress="25"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <!-- Preset Thickness Quick Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/chipThick1"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="1.0 mm"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_preset_chip"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipThick2"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="2.0 mm"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_preset_chip"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipThick3"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="3.5 mm"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_preset_chip"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipThick5"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="5.0 mm"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_preset_chip"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipThick8"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="8.0 mm"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_preset_chip"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Color Palette Group -->
            <LinearLayout
                android:id="@+id/groupColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutStyleColorSwatches"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 4. Text Specific Options (Visible when text selected) -->
            <LinearLayout
                android:id="@+id/groupTextOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Font Family"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnFontSans"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Sans"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_preset_chip"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnFontSerif"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="Serif"
                        android:textSize="12sp"
                        android:fontFamily="serif"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_preset_chip"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnFontMono"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="Mono"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_preset_chip"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnFontScript"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="Script"
                        android:textSize="12sp"
                        android:fontFamily="cursive"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_preset_chip"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Shape Fill Group (Visible when shapes selected) -->
            <LinearLayout
                android:id="@+id/groupShapeFill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Graphic Filling"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchShapeFill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <HorizontalScrollView
                    android:id="@+id/scrollShapeFillColors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutShapeFillColors"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
