<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_page_color"
            app:tint="@color/accent"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Page Background Color"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose paper tone or pick custom color"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Color Presets Horizontal Scroll / Wrap Grid -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paper Presets"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/layoutColorPresets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <!-- Programmatically populated swatches with selection indicators -->
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Custom Color Picker Button -->
    <LinearLayout
        android:id="@+id/btnOpenCustomColorPicker"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_floating_pill"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_palette"
            app:tint="@color/accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Advanced Color Wheel &amp; Hex..."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <View
            android:id="@+id/previewSelectedBgColor"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_tool_button_active" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="12dp" />

    <!-- Checkbox: Set as Notebook Default -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkSetAsNotebookDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set as default for new pages"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:checked="true" />

    <!-- Checkbox: Apply to all pages -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkApplyToAllPages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apply to all pages in this notebook"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:checked="false"
        android:layout_marginBottom="16dp" />

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelColorDialog"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnApplyColorDialog"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Apply Background"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/accent" />
    </LinearLayout>

</LinearLayout>
