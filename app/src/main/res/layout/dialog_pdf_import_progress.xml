<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_pill_surface"
    android:padding="24dp">

    <!-- Header with Icon and Titles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textSize="22sp"
            android:text="📄"
            android:background="@drawable/bg_pill_accent"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textImportTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Importing PDF"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textImportSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Rendering pages into notebook canvas…"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Progress Indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressPdfImport"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:indeterminate="true"
        app:indicatorColor="@color/accent"
        app:trackColor="#2638BDF8"
        app:trackCornerRadius="4dp" />

    <!-- Status text & Page counter -->
    <TextView
        android:id="@+id/textImportStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Reading document pages…"
        android:textColor="@color/text_hint"
        android:textSize="13sp" />

</LinearLayout>
